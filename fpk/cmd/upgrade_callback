#!/bin/bash
# 升级后:渲染持久化配置,并强制重建镜像使新代码生效

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/common.sh"

wyydl_apply_settings || exit 1

compose="${TRIM_APPDEST}/docker/docker-compose.yaml"
if grep -Eq '^[[:space:]]+build:' "$compose"; then
    if ! docker compose -f "$compose" build; then
        [ -n "$TRIM_TEMP_LOGFILE" ] && echo "本地镜像构建失败:请确认设备可访问基础镜像源和 PyPI 后重试升级" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
else
    echo "使用预构建镜像,升级时跳过本地构建"
fi
exit 0
