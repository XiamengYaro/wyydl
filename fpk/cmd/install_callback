#!/bin/bash
# 安装后:应用向导配置、初始化数据目录、预构建镜像(幂等)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/common.sh"

mkdir -p "${TRIM_PKGVAR}/config" "${TRIM_PKGVAR}/db" "${TRIM_PKGVAR}/logs"

wyydl_apply_settings || exit 1

compose="${TRIM_APPDEST}/docker/docker-compose.yaml"
if grep -Eq '^[[:space:]]+build:' "$compose"; then
    if ! docker compose -f "$compose" build; then
        [ -n "$TRIM_TEMP_LOGFILE" ] && echo "本地镜像构建失败:请确认 Docker 可访问基础镜像源和 PyPI" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
else
    echo "使用预构建镜像,跳过本地构建"
fi
exit 0
