#!/bin/bash
# 应用生命周期:compose 完全由本应用的启停脚本管理(不使用 appcenter 的 docker-project 托管,
# 否则安装时注册的旧配置会覆盖向导渲染的端口/目录)

COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"
MAIN_CONTAINER="wyydl-sync"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

is_running () {
    docker inspect "$MAIN_CONTAINER" 2>/dev/null | grep -q '"Status": "running",'
}

ensure_compose () {
    # 按向导/持久化配置渲染 compose(自定义端口、音乐目录)
    # shellcheck disable=SC1091
    [ -f "$SCRIPT_DIR/common.sh" ] && . "$SCRIPT_DIR/common.sh" && wyydl_apply_settings >/dev/null 2>&1 || true
}

case $1 in
start)
    ensure_compose
    if ! is_running; then
        docker compose -f "$COMPOSE_FILE" up -d >/dev/null 2>&1 || true
    fi
    if is_running; then exit 0; fi
    exit 1
    ;;
stop)
    docker compose -f "$COMPOSE_FILE" stop >/dev/null 2>&1 || true
    exit 0
    ;;
status)
    if is_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
